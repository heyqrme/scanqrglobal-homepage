{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|images/|robots\\.txt|sitemap\\.xml|llms\\.txt|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
